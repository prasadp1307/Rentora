{
  "name": "rentora",
  "private": true,
  "version": "0.1.0",
  "description": "Property rental portal monorepo",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "dev:web": "pnpm --filter @rentora/web dev",
    "dev:api": "pnpm --filter @rentora/api dev",
    "build": "pnpm run -r build",
    "lint": "pnpm run -r lint",
    "test": "pnpm run -r test",
    "typecheck": "pnpm run -r typecheck",
    "db:generate": "pnpm --filter @rentora/api prisma:generate",
    "db:migrate": "pnpm --filter @rentora/api prisma:migrate",
    "db:seed": "pnpm --filter @rentora/api prisma:seed",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml down"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
