generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TENANT
  OWNER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum PropertyType {
  APARTMENT
  FLAT
  INDEPENDENT_HOUSE
  VILLA
  STUDIO
  SHARED_ACCOMMODATION
  PG
  OTHER
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  UNPUBLISHED
  RENTED
  ARCHIVED
}

enum FurnishingType {
  FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  INTERESTED
  CLOSED
  WITHDRAWN
}

enum VisitStatus {
  PENDING
  ACCEPTED
  REJECTED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

enum NotificationType {
  ENQUIRY_NEW
  ENQUIRY_STATUS
  VISIT_REQUEST
  VISIT_STATUS
  LISTING_MODERATION
  LISTING_AVAILABILITY
  SYSTEM
}

enum ReportTargetType {
  PROPERTY
  USER
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique
  passwordHash    String
  role            UserRole
  status          AccountStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  profile              UserProfile?
  ownerProfile         OwnerProfile?
  properties           Property[]            @relation("PropertyOwner")
  favourites           Favourite[]
  enquiries            Enquiry[]
  visitRequests        VisitRequest[]
  notifications        Notification[]
  reportsFiled         Report[]              @relation("Reporter")
  auditLogs            AuditLog[]            @relation("AuditActor")
  refreshTokens        RefreshToken[]
  emailVerification    EmailVerificationToken?
  passwordResetTokens  PasswordResetToken[]

  @@index([role])
  @@index([status])
}

model UserProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  firstName   String
  lastName    String
  phone       String?
  avatarUrl   String?
  preferences Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OwnerProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  companyName  String?
  displayName  String?
  contactEmail String?
  contactPhone String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Property {
  id                         String         @id @default(uuid()) @db.Uuid
  ownerId                    String         @db.Uuid
  title                      String
  description                String         @db.Text
  propertyType               PropertyType
  listingStatus              ListingStatus  @default(DRAFT)
  furnishing                 FurnishingType

  country                    String
  state                      String
  city                       String
  locality                   String
  addressLine                String
  showExactAddress           Boolean        @default(false)
  postalCode                 String
  latitude                   Decimal?       @db.Decimal(10, 7)
  longitude                  Decimal?       @db.Decimal(10, 7)
  mapLatApprox               Decimal?       @db.Decimal(10, 7)
  mapLngApprox               Decimal?       @db.Decimal(10, 7)

  monthlyRent                Decimal        @db.Decimal(12, 2)
  securityDeposit            Decimal?       @db.Decimal(12, 2)
  maintenanceCharges         Decimal?       @db.Decimal(12, 2)
  leaseDurationMonths        Int?
  minimumStayMonths          Int?
  availableFrom              DateTime?
  rentNegotiable             Boolean        @default(false)
  brokerageInfo              String?
  preferredTenantCriteria    String?

  bedrooms                   Int
  bathrooms                  Int
  balconies                  Int            @default(0)
  builtUpArea                Decimal?       @db.Decimal(10, 2)
  carpetArea                 Decimal?       @db.Decimal(10, 2)
  areaUnit                   String         @default("sqft")
  floorNumber                Int?
  totalFloors                Int?
  parkingAvailable           Boolean        @default(false)
  propertyAgeYears           Int?

  videoTourUrl               String?
  floorPlanUrl               String?

  moderationNote             String?
  publishedAt                DateTime?
  lastAvailabilityVerifiedAt DateTime?
  viewCount                  Int            @default(0)
  favouriteCount             Int            @default(0)
  enquiryCount               Int            @default(0)

  deletedAt                  DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  owner            User              @relation("PropertyOwner", fields: [ownerId], references: [id])
  images           PropertyImage[]
  propertyAmenities PropertyAmenity[]
  favourites       Favourite[]
  enquiries        Enquiry[]
  visitRequests    VisitRequest[]
  reports          Report[]

  @@index([ownerId])
  @@index([listingStatus])
  @@index([city, locality])
  @@index([monthlyRent])
  @@index([bedrooms])
  @@index([propertyType])
  @@index([publishedAt])
  @@index([createdAt])
}

model PropertyImage {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  storageKey String
  url        String
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
}

model Amenity {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  category    String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  propertyAmenities PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String @db.Uuid
  amenityId  String @db.Uuid

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

model Favourite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  propertyId String   @db.Uuid
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
}

model Enquiry {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @db.Uuid
  propertyId String        @db.Uuid
  message    String?       @db.Text
  status     EnquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  tenant   User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
}

model VisitRequest {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @db.Uuid
  propertyId      String      @db.Uuid
  requestedAt     DateTime
  message         String?     @db.Text
  status          VisitStatus @default(PENDING)
  ownerResponse   String?     @db.Text
  rescheduledAt   DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant   User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Report {
  id           String           @id @default(uuid()) @db.Uuid
  reporterId   String           @db.Uuid
  targetType   ReportTargetType
  propertyId   String?          @db.Uuid
  targetUserId String?          @db.Uuid
  reason       String
  details      String?          @db.Text
  status       ReportStatus     @default(OPEN)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  reporter User      @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PropertyCategory {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  id        String   @id @default(uuid()) @db.Uuid
  country   String
  state     String
  city      String
  slug      String   @unique
  isPopular Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
}
